# 复制为 .env 后仅供本机使用。不要提交真实密钥。

# 第一阶段：PHP 8.4 + ThinkPHP 8.1 + MySQL 8.4 LTS。
MYSQL_ROOT_PASSWORD=root-local-only
MYSQL_DATABASE=learning
MYSQL_USER=learnphp
MYSQL_PASSWORD=learnphp-local-only
THINKPHP_HOST_PORT=18081
FRONTEND_HOST_PORT=15173

# 第二阶段：独立的 compose.magento.yaml 项目与数据库。第一阶段不用填写。
MAGENTO_MYSQL_ROOT_PASSWORD=root-local-only
MAGENTO_MYSQL_DATABASE=magento
MAGENTO_MYSQL_USER=magento
MAGENTO_MYSQL_PASSWORD=magento-local-only
MAGENTO_MYSQL_HOST_PORT=13308
# 下载 Magento 代码前填写 Marketplace 密钥。
MAGENTO_VERSION=2.4.8-p5
MAGENTO_PUBLIC_KEY=
MAGENTO_PRIVATE_KEY=
RABBITMQ_DEFAULT_USER=magento
RABBITMQ_DEFAULT_PASS=magento-local-only
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123456!
MAGENTO_ADMIN_EMAIL=admin@example.com

# 宿主机端口；容器之间仍使用各服务的标准端口。
WEB_HOST_PORT=8080
MYSQL_HOST_PORT=13307
VALKEY_HOST_PORT=6380
OPENSEARCH_HOST_PORT=9200
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MAGENTO_HOST_PORT=8088
