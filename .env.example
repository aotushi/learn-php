# 复制为 .env 后仅供本机使用。不要提交真实密钥。
MAGENTO_VERSION=2.4.8-p5
MAGENTO_PUBLIC_KEY=
MAGENTO_PRIVATE_KEY=

# 以下账户只用于本机学习环境。
MARIADB_ROOT_PASSWORD=root-local-only
MARIADB_DATABASE=magento
MARIADB_USER=magento
MARIADB_PASSWORD=magento-local-only
RABBITMQ_DEFAULT_USER=magento
RABBITMQ_DEFAULT_PASS=magento-local-only
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123456!
MAGENTO_ADMIN_EMAIL=admin@example.com

# 宿主机端口；容器之间仍使用各服务的标准端口。
WEB_HOST_PORT=8080
MARIADB_HOST_PORT=13307
VALKEY_HOST_PORT=6380
OPENSEARCH_HOST_PORT=9200
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MAGENTO_HOST_PORT=8088
